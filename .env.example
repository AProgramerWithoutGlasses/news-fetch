# 复制为 .env，密钥只存本机；不会提交到 Git。
NEWS_DATA_DIR=data
NEWS_REPORT_DIR=reports
NEWS_POLL_MINUTES=20
# X 渠道必需：X 官方 recent search 的 Bearer Token（需要相应接口权限）
X_BEARER_TOKEN=
# 可选：OpenAI 兼容接口，用于中文标题/摘要。留空则使用原文摘录。
NEWS_LLM_BASE_URL=
NEWS_LLM_API_KEY=
NEWS_LLM_MODEL=
# 可选：现有合法出站代理，不配置则直连。配置后下一次任务生效。
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
